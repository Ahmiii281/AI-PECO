# =========================
# AI / ML — Large Dataset Files ONLY
# =========================
# Block the raw dataset files (100MB+) that cannot go to GitHub.
# The ml/ folder itself, model files (.pkl, .h5, .joblib, .keras),
# and all Python code inside ml/ are NOT ignored.

# Specific large dataset file
ml/datasets/data/household_power_consumption.txt

# Generic catch-all for any future large datasets dropped in these folders
ml/datasets/data/*.txt
ml/datasets/data/*.csv
ml/datasets/data/*.parquet
ml/datasets/data/*.zip
ml/datasets/data/*.tar
ml/datasets/data/*.tar.gz
ml/datasets/data/*.gz

# Backend copy (if datasets are ever placed there too)
backend/ml/datasets/data/*.txt
backend/ml/datasets/data/*.csv
backend/ml/datasets/data/*.parquet
backend/ml/datasets/data/*.zip

