// =============================================================================
// AI-PECO ESP32 Credentials Configuration
// =============================================================================
// IMPORTANT: Fill in these values with your actual WiFi credentials and backend URL
// This file is NOT committed to git (it's in .gitignore)
//
// How to use:
// 1. Copy this file as 'credentials.h' in the esp32/ directory
// 2. Edit the values below
// 3. Save and upload to ESP32
// =============================================================================

#ifndef CREDENTIALS_H
#define CREDENTIALS_H

// ─────────────────────────────────────────────────────────────────────────
// WiFi Configuration
// ─────────────────────────────────────────────────────────────────────────

// Your WiFi SSID (network name)
#define WIFI_SSID "YOUR_WIFI_SSID_HERE"

// Your WiFi password
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD_HERE"

// ─────────────────────────────────────────────────────────────────────────
// Backend Server Configuration
// ─────────────────────────────────────────────────────────────────────────

// Backend server IP address and port
// Find your PC/server IP with: ipconfig (Windows) or ifconfig (Linux/Mac)
// Example: http://192.168.1.100:8000
#define BACKEND_URL "http://YOUR_BACKEND_IP:8000"

// Device API Key (must match DEVICE_API_KEY in backend .env)
#define DEVICE_API_KEY "esp32_secure_api_key_here"

// ─────────────────────────────────────────────────────────────────────────
// Device Identification (MongoDB ObjectIds)
// ─────────────────────────────────────────────────────────────────────────

// Note: These will be populated by backend demo seeder
// Or manually enter if you want specific device IDs

const char* deviceIds[] = {
    "device1",   // Relay IN1 (GPIO 14) - e.g., "Living Room AC"
    "device2",   // Relay IN2 (GPIO 27) - e.g., "Kitchen Appliances"
    "device3",   // Relay IN3 (GPIO 26) - e.g., "Water Heater"
    "device4",   // Relay IN4 (GPIO 25) - e.g., "Bedroom Fan"
};

#endif // CREDENTIALS_H
