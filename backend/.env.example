# =============================================================================
# AI-PECO BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values.
# CRITICAL: Never commit .env to version control.
#
# For production on Railway:
# 1. Set all REQUIRED variables in Railway Dashboard
# 2. Do NOT include .env file in Docker build
# 3. Railway will inject $PORT automatically
#
# Generate a strong SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=AI-PECO
APP_VERSION=1.0.0
DEBUG=false

# ─── Database (MongoDB Atlas) ──────────────────────────────────────────────────
# REQUIRED IN PRODUCTION
# Format: mongodb+srv://username:password@cluster.xxx.mongodb.net/?retryWrites=true&w=majority
# Get from: MongoDB Atlas → Connect → Connect your application
MONGODB_URL=mongodb+srv://ba341914_db_user:Aipeco12345@aipecocluster.83ttwti.mongodb.net/?retryWrites=true&w=majority&appName=aipecocluster
DATABASE_NAME=ba341914_db_users

# ─── JWT Secret Key ────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION - Must be a random, 32+ character string
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep this value secure and consistent across all app instances
SECRET_KEY=

# ─── CORS Origins ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local dev: http://localhost:3000,http://localhost:5173
# Production: https://ai-peco-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://ai-peco-frontend.vercel.app

# ─── Server Port ───────────────────────────────────────────────────────────────
# Railway injects PORT automatically. Local development only: PORT=8000
PORT=8000

# ─── ESP32 Device API Authentication ───────────────────────────────────────────
# Set to True in production. Set to False only during local development if no hardware yet.
DEVICE_API_KEY_REQUIRED=true
# Optional: Shared API key for ESP32 devices
DEVICE_API_KEY=

# ─── Energy & Billing ──────────────────────────────────────────────────────────
ELECTRICITY_TARIFF_PKR=50.0
ANOMALY_THRESHOLD_SIGMA=2.0
DATA_RETENTION_DAYS=30

# ─── Demo Mode ─────────────────────────────────────────────────────────────────
# True: Simulated ESP32 data generated automatically (demo/development)
# False: Only real hardware data accepted
DEMO_MODE=true

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email (uses log-only fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ai-peco.com
SMTP_USE_TLS=true

# ─── Frontend URL ──────────────────────────────────────────────────────────────
# Used for password-reset links in emails
FRONTEND_URL=https://ai-peco-frontend.vercel.app

# ─── Features ──────────────────────────────────────────────────────────────────
ENABLE_AI_PREDICTIONS=true
ENABLE_AUTO_ALERTS=true

# ─── JWT Configuration ────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
DEMO_ADMIN_PASSWORD=Admin123!

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Used for password reset emails.
# Leave SMTP_HOST empty to use log-only fallback (dev/demo mode).
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-app-password  ← Use App Password (not account password)
#
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxx...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ai-peco.com
SMTP_USE_TLS=True

# ── Frontend ──────────────────────────────────────────────────────────────────
# Used to build password reset links in emails.
FRONTEND_URL=https://ai-peco-frontend.vercel.app
# For local development: FRONTEND_URL=http://localhost:5173

# ── Features ─────────────────────────────────────────────────────────────────
ENABLE_AI_PREDICTIONS=True
ENABLE_AUTO_ALERTS=True

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── OpenAI API Key ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_actual_key_here
