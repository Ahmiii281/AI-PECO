# ─── AI-PECO Backend Environment Configuration ───────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
#
# Generate a strong SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=AI-PECO
APP_VERSION=1.0.0
DEBUG=False                         # Set to True only during local development

# ── Database ──────────────────────────────────────────────────────────────────
# For local development:
# MONGODB_URL=mongodb://localhost:27017
# For MongoDB Atlas (production):
# Use your Atlas cluster URL and credentials.
# Example using the configured cluster/username below:
# mongodb+srv://ba341914_db_user:<password>@aipecocluster.83ttwti.mongodb.net/?appName=aipecocluster
MONGODB_URL=mongodb+srv://<username>:<password>@aipecocluster.83ttwti.mongodb.net/?appName=aipecocluster
DATABASE_NAME=ba341914_db_users

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED in production. Must be a strong, random 48+ character string.
SECRET_KEY=CHANGE_ME_USE_TOKEN_URLSAFE_48
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://ai-peco-frontend.vercel.app

# ── ESP32 / Device API Key ────────────────────────────────────────────────────
# The ESP32 firmware must send this value in X-API-Key header.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
DEVICE_API_KEY=CHANGE_ME_TO_RANDOM_KEY
# Set to False only during local hardware development (no key required).
DEVICE_API_KEY_REQUIRED=True

# ── Energy & Billing ──────────────────────────────────────────────────────────
# FESCO default: PKR 50/kWh. Adjust to your electricity tariff.
ELECTRICITY_TARIFF_PKR=50.0
ANOMALY_THRESHOLD_SIGMA=2.0

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# True = Generate simulated ESP32 data (for demo/development)
# False = Only accept real hardware data
DEMO_MODE=True
# Password for the auto-created demo admin account
DEMO_ADMIN_PASSWORD=Admin123!

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Used for password reset emails.
# Leave SMTP_HOST empty to use log-only fallback (dev/demo mode).
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-app-password  ← Use App Password (not account password)
#
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxx...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ai-peco.com
SMTP_USE_TLS=True

# ── Frontend ──────────────────────────────────────────────────────────────────
# Used to build password reset links in emails.
FRONTEND_URL=https://ai-peco-frontend.vercel.app
# For local development: FRONTEND_URL=http://localhost:5173

# ── Features ─────────────────────────────────────────────────────────────────
ENABLE_AI_PREDICTIONS=True
ENABLE_AUTO_ALERTS=True

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── OpenAI API Key ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_actual_key_here
