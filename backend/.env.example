# ═══════════════════════════════════════════════════════════════════════════
# AI-PECO Backend Configuration (.env)
# ═══════════════════════════════════════════════════════════════════════════
# 
# IMPORTANT: 
# 1. Copy this file to .env
# 2. Edit with your actual values
# 3. NEVER commit .env to git (it's in .gitignore)
# 4. Keep SECRET_KEY safe and strong
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────────────────────────────────

APP_NAME=AI-PECO
APP_VERSION=1.0.0

# Set to False for production
DEBUG=True

# ─────────────────────────────────────────────────────────────────────────
# Security - CRITICAL: Change these for production
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED: Strong random secret key for JWT signing
# For development: leave empty to auto-generate (will be different each startup)
# For production: MUST set to permanent strong value (tokens will break if changed!)
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=

# API Key for ESP32 device communication (if DEBUG=False)
DEVICE_API_KEY=esp32_secure_api_key_here

# ─────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────

# Local MongoDB (for development)
MONGODB_URL=mongodb://localhost:27017

# MongoDB Atlas (for cloud, if used)
# MONGODB_URL=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority

DATABASE_NAME=ba341914_db_users

# ─────────────────────────────────────────────────────────────────────────
# CORS - Allowed frontend URLs
# ─────────────────────────────────────────────────────────────────────────

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://ai-peco.vercel.app

# ─────────────────────────────────────────────────────────────────────────
# ESP32 / Hardware Configuration
# ─────────────────────────────────────────────────────────────────────────

# Poll interval for checking ESP32 device status (seconds)
ESP32_POLLING_INTERVAL=5

# How long to keep energy data (days) - older data is deleted
DATA_RETENTION_DAYS=30

# ─────────────────────────────────────────────────────────────────────────
# Energy Settings
# ─────────────────────────────────────────────────────────────────────────

# Cost per unit of electricity (PKR/kWh)
ENERGY_PRICE_PER_UNIT=50

# Standard deviations for anomaly detection
ANOMALY_THRESHOLD_SIGMA=2.0

# ─────────────────────────────────────────────────────────────────────────
# AI/ML Features
# ─────────────────────────────────────────────────────────────────────────

# Enable ML-based energy predictions
ENABLE_AI_PREDICTIONS=True

# Enable automated alerts for anomalies
ENABLE_AUTO_ALERTS=True

# ─────────────────────────────────────────────────────────────────────────
# Demo Mode - When ESP32 hardware is not available
# ─────────────────────────────────────────────────────────────────────────

# Set to True to enable demo data generation (for testing without hardware)
DEMO_MODE=True

# Password for demo admin user (if not set, auto-generated random password)
# Leave empty for automatic generation, or set to specific password
DEMO_ADMIN_PASSWORD=admin123

# ─────────────────────────────────────────────────────────────────────────
# Password Reset Configuration
# ─────────────────────────────────────────────────────────────────────────
# When a user requests password reset:
# 1. System generates a secure token (32 bytes, URL-safe)
# 2. Token is printed to console/logs (no email service in this version)
# 3. User receives token and submits it with new password
# 4. Token expires after 1 hour
# ═════════════════════════════════════════════════════════════════════════
