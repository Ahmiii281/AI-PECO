# =============================================================================
# AI-PECO FRONTEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local (local development)
# For Vercel production: Set variables in Dashboard → Environment Variables
# CRITICAL: Never commit .env or .env.local to version control
#
# For Vercel Production:
# 1. Go to Vercel Dashboard → Project Settings → Environment Variables
# 2. Add VITE_API_URL=https://your-railway-backend.up.railway.app
# 3. Commit and push to GitHub (Vercel auto-deploys)
# =============================================================================

# ─── Backend API URL ───────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION
# Format:
# - Local development: http://localhost:8000
# - Vercel production: https://aipeco-backend.up.railway.app (or your Railway URL)
#
# CRITICAL: This MUST be set in Vercel environment variables for production
VITE_API_URL=http://localhost:8000

# ─── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to use mock data (no backend connection required)
# Set to "false" to require real backend API
VITE_USE_DEMO_DATA=true

# ─── Application Metadata ──────────────────────────────────────────────────────
VITE_APP_NAME=AI-PECO
VITE_APP_VERSION=1.0.0
